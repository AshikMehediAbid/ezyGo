{
  "ConnectionStrings": {
    "AuthConnection": "Server=your-production-server;Database=ezyGoAuth;Trusted_Connection=true;MultipleActiveResultSets=true;TrustServerCertificate=true"
  },
  "Jwt": {
    "Key": "YOUR_PRODUCTION_JWT_SECRET_KEY_HERE_MINIMUM_256_BITS",
    "Issuer": "ezyGoAuth",
    "Audience": "ezyGoClient"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "yourdomain.com,www.yourdomain.com"
}
